{
  "expo": {
    "name": "IslaPabili",
    "slug": "islapabili",
    "scheme": "islapabili",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
          "icon": "./assets/islapabili_logo.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ph.islapabili.app"
    },
    "android": {
      "package": "ph.islapabili.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#065F59"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "name": "IslaPabili",
      "shortName": "IslaPabili",
      "favicon": "./assets/islapabili_logo.png"
    },
    "plugins": [
      "expo-image-picker",
      "expo-web-browser",
      [
        "expo-notifications",
        {
    "icon": "./assets/islapabili_logo.png",
          "color": "#065F59"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "IslaPabili uses your location to track deliveries live.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/islapabili_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FBF5E9"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraDependencies": ["androidx.core:core-splashscreen:1.2.0"]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d8522891-0d14-408a-b9d9-9a2f95feb2e0"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d8522891-0d14-408a-b9d9-9a2f95feb2e0",
      "checkAutomaticallyOnLaunch": "ALWAYS",
      "fallbackToCacheTimeout": 0
    }
  }
}
