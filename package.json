{
  "name": "islapabili",
  "version": "0.1.0",
  "private": true,
  "description": "IslaPabili - Marinduque on-demand pabili & delivery platform (MVP v1.0)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:customer": "npm run start --workspace @isla/mobile-customer",
    "dev:rider": "npm run start --workspace @isla/mobile-rider",
    "dev:admin": "npm run dev --workspace @isla/admin-web",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "build": "turbo run build",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}