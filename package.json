{
  "name": "islapabili",
  "version": "0.1.0",
  "private": true,
  "description": "IslaPabili - Marinduque on-demand pabili & delivery platform (MVP v1.0)",
  "main": "apps/mobile/index.ts",
  "workspaces": [
    "apps/admin-web",
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm run start --workspace @isla/mobile",
    "dev:admin": "npm run dev --workspace @isla/admin-web",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "build": "turbo run build",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset"
  },
  "packageManager": "npm@11.6.3",
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "turbo": "^2.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
