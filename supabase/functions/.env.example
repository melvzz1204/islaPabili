# Local dev only (`supabase functions serve send-sms --no-verify-jwt --env-file supabase/functions/.env`).
# Production values are set via `supabase secrets set` — never commit real keys.
SEND_SMS_HOOK_SECRET=v1,whsec_replace-with-local-dev-secret
SEMAPHORE_API_KEY=replace-with-semaphore-api-key
# Optional: omit to use the account's default Semaphore sender name.
SEMAPHORE_SENDERNAME=
